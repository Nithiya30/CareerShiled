# CareerShield Environment Configuration

# Hugging Face Inference API (Optional)
# If omitted or unavailable, CareerShield automatically falls back to local supervised ML & agents
HF_TOKEN=
HF_MODEL=distilbert/distilbert-base-uncased-finetuned-sst-2-english

# Verification & Reputation API Keys (optional)
WHOISJSON_API_KEY=""        # Optional: HTTP WHOIS fallback API key
SERPER_API_KEY=""           # Optional: For Google Search & News Sentiment API
CLEARBIT_API_KEY=""         # Optional: Company Entity Enrichment
PORT=8000
MAX_UPLOAD_SIZE_BYTES=10485760
# Optional absolute path when Tesseract is not available on PATH.
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Backend Database (SQLite for dev, easily swappable with postgresql://user:pass@localhost:5432/careershield)
DATABASE_URL=sqlite:///./careershield.db

# Frontend API Base URL
VITE_API_URL=http://localhost:8000

# Browser authentication (set AUTH_COOKIE_SECURE=true behind HTTPS)
AUTH_SESSION_TTL_HOURS=12
AUTH_COOKIE_SAMESITE=lax
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Add the exact Chrome extension ID origin after loading the unpacked extension.
EXTENSION_ORIGINS=chrome-extension://ineohmdghfadcgjgedpfchpbfmoacpga
# Set ENVIRONMENT=production (or AUTH_COOKIE_SECURE=true) when serving over HTTPS.

# Gmail OAuth (optional; requires a Google Cloud OAuth client of type Web application).
# Register this exact callback URI in Google Cloud Authorized redirect URIs.
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_OAUTH_REDIRECT_URI=http://127.0.0.1:8000/api/gmail/oauth/callback
# Must be an origin included in CORS_ORIGINS. Gmail connection results return here.
GMAIL_OAUTH_RETURN_URL=http://127.0.0.1:5173/?page=gmail
# Generate a Fernet key with:
# .\.venv\Scripts\python.exe -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Store key versions as JSON; keep old versions available until ciphertext is rotated.
# Example only (replace the placeholder with a newly generated key):
GMAIL_TOKEN_ENCRYPTION_KEYS=
GMAIL_TOKEN_ACTIVE_KEY_VERSION=v1

# Application-level auth rate limits (in-memory; single process only)
AUTH_RATE_LIMIT_WINDOW_SECONDS=900
AUTH_LOGIN_IP_LIMIT=30
AUTH_LOGIN_ACCOUNT_IP_LIMIT=5
AUTH_REGISTRATION_WINDOW_SECONDS=3600
AUTH_REGISTRATION_IP_LIMIT=5
# Only set behind a proxy that strips/replaces X-Forwarded-For; use exact proxy IPs/CIDRs.
TRUSTED_PROXY_IPS=

# Private company investigations (application-level, in-memory limit)
COMPANY_INVESTIGATION_LIMIT=5
COMPANY_INVESTIGATION_WINDOW_SECONDS=3600

# WorkLife Intelligence
WORKLIFE_MIN_OVERALL_REVIEWS=5
WORKLIFE_MIN_CATEGORY_REVIEWS=2
WORKLIFE_REVIEW_LIMIT=5
WORKLIFE_REVIEW_WINDOW_SECONDS=3600
# Comma-separated account email allowlist for review moderation; empty disables moderator access.
WORKLIFE_MODERATOR_EMAILS=
# Optional JSON object with positive weights for all eight WorkLife categories.
# Defaults to equal weights.
WORKLIFE_SCORE_WEIGHTS={"work_life_balance":0.125,"salary_satisfaction":0.125,"management":0.125,"career_growth":0.125,"learning_opportunities":0.125,"work_pressure":0.125,"job_security":0.125,"overall_satisfaction":0.125}
